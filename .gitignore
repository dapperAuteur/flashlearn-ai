# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# Scratch build dirs from parallel builds. Next only reads distDir from
# next.config.mjs, so a NEXT_DIST_DIR env var does nothing; anyone working
# around build contention has to edit the config, and these are the leftovers.
/.next-*/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# but DO commit the canonical sample template — it's the onboarding doc.
!.env.sample
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

mongo-data/

docs/data-backup/
.env*.local

.claude/

plans/

# Playwright output
test-results/
playwright-report/

# Tutorial pipeline (docs/tutorials committed; intermediates + sessions are not)
tutorial-output/
docs/tutorials/video/
audio/
.auth/
