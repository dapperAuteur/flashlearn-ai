# =============================================================================
# FlashLearn AI — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values for local dev.
# In Vercel/production, set these in the project's Environment Variables UI.
#
# REQUIRED groups are flagged below. Others are optional or feature-gated
# (the app boots without them; specific features fail or no-op).
# =============================================================================

# ─── REQUIRED: Database ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/flashcard-ai

# ─── REQUIRED: NextAuth ──────────────────────────────────────────────────────
# NEXTAUTH_SECRET: generate with `openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# ─── REQUIRED: Gemini AI (per key type — at least PUBLIC for the public API) ─
# Each API-key type gets its own Gemini key so usage and rate limits are
# isolated across access tiers. PUBLIC is the most-used in production.
# ECOSYSTEM was added for cross-product consumers (Wanderlearn etc.); it can
# alias to GEMINI_API_KEY_PUBLIC initially.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY_PUBLIC=your-gemini-api-key
GEMINI_API_KEY_ADMIN=your-gemini-api-key
GEMINI_API_KEY_ADMIN_PUBLIC=your-gemini-api-key
GEMINI_API_KEY_APP=your-gemini-api-key
GEMINI_API_KEY_ECOSYSTEM=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-2.0-flash

# ─── AI provider selection (lib/ai/providers.ts) ────────────────────────────
# All AI features (flashcards, answer eval, distractors, RAG, banners) run
# through a switchable provider layer. LLM_PROVIDER picks the text backend;
# Cerebras/OpenRouter/Mistral/Together are OpenAI-compatible, Gemini routes via
# the Google provider. Set the matching *_API_KEY for whichever you select.
# Image flashcards use LLM_VISION_PROVIDER (default mistral / mistral-small) because
# text-only providers like Cerebras can't accept images. Audio flashcards always
# use Gemini (GEMINI_API_KEY) regardless of LLM_PROVIDER.
LLM_PROVIDER=cerebras                  # cerebras | openrouter | mistral | together | gemini
# LLM_TEXT_MODEL=                      # optional model-id override for the text provider
LLM_VISION_PROVIDER=mistral            # provider used for image input
# LLM_VISION_MODEL=                    # optional model-id override for the vision provider
CEREBRAS_API_KEY=your-cerebras-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
MISTRAL_API_KEY=your-mistral-api-key
TOGETHER_API_KEY=your-together-api-key

# ─── Feature flags ──────────────────────────────────────────────────────────
# Feature flags are stored in MongoDB (appconfigs → FEATURE_FLAGS), not env vars.
# Toggle them from the admin dashboard at Admin → Settings → Feature Flags
# (no redeploy). Audio flashcard generation ships off ("coming soon" for everyone
# but admins) until flipped on there.

# ─── REQUIRED: Upstash Redis (rate limits, webhook milestone dedupe) ────────
# Either UPSTASH_REDIS_* or STORAGE_KV_* names work — STORAGE_KV_* is
# auto-injected by Vercel's Marketplace integration; UPSTASH_REDIS_* matches
# the standalone Upstash console naming. The code accepts either prefix.
UPSTASH_REDIS_REST_URL=your-redis-url
UPSTASH_REDIS_REST_TOKEN=your-redis-token
# STORAGE_KV_REST_API_URL=your-redis-url
# STORAGE_KV_REST_API_TOKEN=your-redis-token

# ─── REQUIRED for ecosystem webhooks: Upstash QStash ─────────────────────────
# Used for delayed session delivery and outbound webhook retry/backoff.
# Either QSTASH_* or UPSTASH_QSTASH_* names work — same pattern as Redis.
UPSTASH_QSTASH_URL=https://qstash.upstash.io
UPSTASH_QSTASH_TOKEN=your-qstash-token
UPSTASH_QSTASH_CURRENT_SIGNING_KEY=your-signing-key
UPSTASH_QSTASH_NEXT_SIGNING_KEY=your-next-signing-key
# QSTASH_TOKEN=your-qstash-token
# QSTASH_CURRENT_SIGNING_KEY=your-signing-key
# QSTASH_NEXT_SIGNING_KEY=your-next-signing-key

# ─── REQUIRED for ecosystem webhooks: signing-secret encryption ──────────────
# AES-256-GCM key that encrypts per-WebhookEndpoint signing secrets at rest.
# We must store secrets reversibly because the dispatcher signs outbound
# bodies with the same plaintext the consumer holds.
# Generate with: openssl rand -hex 32
WEBHOOK_ENCRYPTION_KEY=your-64-hex-char-encryption-key

# ─── REQUIRED for cron-triggered jobs ────────────────────────────────────────
# Bearer token Vercel Cron uses to authenticate calls to /api/cron/*
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# ─── Stripe (billing) ────────────────────────────────────────────────────────
# Use TEST keys (sk_test_..., pk_test_...) for development and sandbox.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
# Subscription price IDs — create in Stripe Dashboard → Products
NEXT_PUBLIC_STRIPE_10_MONTHLY_PRICE=price_your-monthly-price-id
NEXT_PUBLIC_STRIPE_100_ANNUAL_PRICE=price_your-annual-price-id
NEXT_PUBLIC_STRIPE_100_LIFETIME_PRICE=price_your-lifetime-price-id
# API metered-billing prices (Developer + Pro tiers, overage usage)
STRIPE_API_DEVELOPER_PRICE_ID=price_your-developer-price-id
STRIPE_API_DEVELOPER_METER_EVENT_NAME=api_developer_overage
STRIPE_API_PRO_PRICE_ID=price_your-pro-price-id
STRIPE_API_PRO_METER_EVENT_NAME=api_pro_overage

# ─── Email — choose ONE provider (SMTP via nodemailer OR Mailgun) ────────────
# SMTP (e.g. Gmail, Postmark, SES via SMTP, etc.):
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-smtp-username
EMAIL_SERVER_PASSWORD=your-smtp-password
EMAIL_SERVER_SECURE=false
EMAIL_FROM=noreply@yourdomain.com
# Mailgun (used by transactional + campaign sender):
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
# Where admin notifications (sign-ups, errors, etc.) are routed
ADMIN_NOTIFICATION_EMAIL=admin.flashlearnai@awews.com

# ─── Cloudinary (image uploads) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ─── Switchy (link shortener / pixel tracking) ───────────────────────────────
SWITCHY_API_TOKEN=your-switchy-token
SWITCHY_DOMAIN=your-shortlink-domain
# Comma-separated pixel IDs to attach to every shortlink
SWITCHY_PIXEL_IDS=

# ─── Self-API access (using the FlashLearn API from another tool) ────────────
# Issue a key from /developer/keys, then paste here for local scripts that
# call FL-AI's own public API.
FLASHLEARN_API_KEY=fl_pub_your-public-api-key

# ─── File Size Limits (in bytes) ─────────────────────────────────────────────
PDF_MAX_SIZE_BYTES=52428800
IMAGE_MAX_SIZE_BYTES=10485760
AUDIO_MAX_SIZE_BYTES=104857600
VIDEO_MAX_SIZE_BYTES=209715200

# ─── File Count Limits ───────────────────────────────────────────────────────
IMAGE_MAX_FILES=10

# ─── Flashcard Generation Limits ─────────────────────────────────────────────
FLASHCARD_MIN=5
FLASHCARD_MAX=50

# --- WitUS ecosystem: Inbox (inbound feedback/help/bug -> BAM triage) ---
INBOX_INGEST_URL=https://inbox.witus.online/api/ingest
INBOX_SOURCE_SLUG=flashlearnai
INBOX_INGEST_SECRET=

# --- WitUS ecosystem: Outbox (outbound social drafts -> BAM accounts) ---
OUTBOX_INGEST_URL=https://outbox.witus.online/api/ingest
OUTBOX_SOURCE_SLUG=flashlearnai
OUTBOX_INGEST_SECRET=
OUTBOX_TRIGGER_ENABLED=true

# --- WitUS ecosystem SSO ("Sign in with WitUS", central OIDC IdP) ---
# Register this app as a client at accounts.witus.online to get the id/secret.
# The provider is only added to NextAuth when WITUS_OIDC_CLIENT_ID is set, and
# the sign-in button only renders when NEXT_PUBLIC_WITUS_SSO=true.
WITUS_OIDC_CLIENT_ID=
WITUS_OIDC_CLIENT_SECRET=
WITUS_OIDC_DISCOVERY_URL=https://accounts.witus.online/api/idp/.well-known/openid-configuration
NEXT_PUBLIC_WITUS_SSO=false

# ─── Homepage A/B test ───────────────────────────────────────────────────────
# Only the exact string "true" switches the test on. Any other value, including
# an unset variable, counts as off.
#
# OFF: every visitor gets the control (the current homepage), no variant cookie
# is issued, the client tracker is never mounted, and POST /api/analytics/ab-test
# answers 202 without writing a row. /admin/ab-test still renders and still shows
# whatever was recorded during an earlier run, with a banner saying the test is
# off. Nothing accumulates while it is off.
#
# ON: middleware assigns a first-time visitor to one of four arms with an even
# split (control, a, b, c) and pins the choice in the fl_home_variant cookie for
# 90 days, so the same person keeps the same design on every later visit. The
# server renders the pinned design, so there is no variant flash. The tracker
# posts one view on mount plus a click event for each homepage CTA that reaches
# signup, signin, generate, study, or dashboard.
#
# Read the results at /admin/ab-test (Admin role required). That page is not in
# the admin sidebar yet, so reach it by typing the URL.
#
# The value is read at request time, not baked into the bundle, but Vercel binds
# environment variables per deployment, so redeploy after changing it rather than
# assuming a live flip took effect. Confirm by loading "/" in a fresh browser
# profile and checking for the fl_home_variant cookie.
HOMEPAGE_AB_TEST_ENABLED=false

# ─── Distributed tracing (Honeycomb, via OpenTelemetry) ──────────────────────
# OPTIONAL. With no key the OTel exporter still initializes but sends nothing,
# so the tracing section of the README describes zero live signal until this is
# set (see plans/user-tasks/30). otel.config.ts reads the _SECRET name first and
# falls back to HONEYCOMB_API_KEY. The two key types use different auth headers,
# so verify by watching for spans to arrive rather than by matching the value.
HONEYCOMB_INGEST_API_KEY_SECRET=
HONEYCOMB_API_KEY=

# ─── Error monitoring (Better Stack, via the Sentry SDK) ─────────────────────
# ALL OPTIONAL. With no DSN the SDK never initializes: no network calls, no
# behavior change. Set the DSN to turn reporting on (see plans/user-tasks/21).
# SENTRY_DSN is used by the server + edge runtimes; NEXT_PUBLIC_SENTRY_DSN is
# the browser DSN and must be present at BUILD time (next.config.mjs adds its
# origin to the CSP connect-src, otherwise the browser is blocked from sending).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Defaults to VERCEL_ENV, then NODE_ENV. Only set to override.
SENTRY_ENVIRONMENT=
# Build-time only, and only needed for readable (unminified) stack traces. The
# build succeeds without them; source maps just are not uploaded.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
